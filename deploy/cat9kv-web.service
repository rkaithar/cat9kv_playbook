[Unit]
Description=Cat9kV ESXi Deployment Tool
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=user
WorkingDirectory=/opt/cat9kv-playbook
Environment=CAT9KV_IMAGE_DIR=/srv/cat9kv/images
Environment=CAT9KV_CATALOG=/opt/cat9kv-playbook/config/version-catalog.example.yaml
Environment=GOVC_BIN=/usr/local/bin/govc
ExecStart=/opt/cat9kv-playbook/venv/bin/python -m uvicorn webapp.app:app --host 127.0.0.1 --port 8080
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
